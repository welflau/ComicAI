# =============================================================================
# ComicFlow AI Platform — Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=comicflow
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=comicflow_db
DATABASE_URL=postgresql+asyncpg://comicflow:changeme_secure_password@postgres:5432/comicflow_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_32char_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=changeme_minio_password
MINIO_BUCKET=comicflow
MINIO_SECURE=false

# ── AI Providers ──────────────────────────────────────────────────────────────
# OpenAI (GPT-4o for script parsing, DALL-E 3 for image generation)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet as fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Stability AI (SDXL image generation)
STABILITY_API_KEY=sk-...

# Replicate (Stable Video Diffusion)
REPLICATE_API_KEY=r8_...

# Azure TTS (Chinese voice synthesis)
AZURE_TTS_KEY=...
AZURE_TTS_REGION=eastasia

# ── Generation Provider Selection ─────────────────────────────────────────────
# Options: dalle3 | stability | sdxl_local
IMAGE_GEN_PROVIDER=dalle3

# Options: replicate_svd | runway
VIDEO_GEN_PROVIDER=replicate_svd

# Options: openai | anthropic
LLM_PROVIDER=openai

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=50
